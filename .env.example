# Local demo defaults. Never place real secrets in this file.
BANK_AGENT_HOST=0.0.0.0
BANK_AGENT_PORT=8090
APP_ENV=demo
ALLOW_DEMO_CORE=true
TASK_STORE_BACKEND=memory
AUDIT_BACKEND=sqlite-hash-chain-demo
AGENT_MAX_RETRIES=3

# Optional model intent extraction. Python does not automatically load .env.
# Keep the offline baseline; set BANK_AGENT_OFFLINE=0 only for explicit online use.
BANK_AGENT_OFFLINE=1
# Optional offline semantic retrieval: prepare/bundle model and CPU dependencies first.
# RAG_EMBEDDING_BACKEND=local
# RAG_LOCAL_MODEL_DIR=models/rag
# RAG_USE_RERANKER=1
# RAG_RERANKER_DIR=models/reranker
# OCR_ENABLED=1
# OCR_MODEL_DIR=models/ocr
# RAG_FUSION=weighted  # local alternative: rrf; choose using paired quality evaluation
# Local vectors work with BANK_AGENT_OFFLINE=1; no API key or outbound consent needed.
# RAG_EMBEDDING_BACKEND=disabled forces lexical-only; auto prefers an installed local model.
# LLM_PROVIDER=siliconflow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# LLM_API_KEY=  # Inject through the OS environment; never paste secrets here.
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_OUTPUT_TOKENS=512
# LLM_CALLS_PER_MINUTE=20
# LLM_MAX_CONCURRENT=2
# VOICE_ENABLED=0
# Setup and acceptance: docs/P02模型接入与验收.md

# Production examples only. Inject real values through a secret manager at deploy time.
# APP_ENV=production
# ALLOW_DEMO_CORE=false
# TASK_STORE_BACKEND=redis
# AUDIT_BACKEND=postgres-worm
# REDIS_URL=rediss://...
# POSTGRES_DSN=postgresql://...
# KMS_KEY_ALIAS=real-kms-key-alias
# SIEM_ENDPOINT=https://real-siem.example/ingest
